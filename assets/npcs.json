[{"id": 1, "name": "爹", "model": "老父.pmg", "portrait": "dad.bmp", "script": "爹.gsp", "hp": 900, "attack": 0, "hostile": 0, "defence": 0, "level": 0, "exp": 0, "ai": 3, "skills": "*/*", "talks": []}, {"id": 2, "name": "娘", "model": "老母.pmg", "portrait": "mom.bmp", "script": "娘.gsp", "hp": 900, "attack": 0, "hostile": 0, "defence": 0, "level": 0, "exp": 0, "ai": 4, "skills": "*/*", "talks": []}, {"id": 3, "name": "李大婶", "model": "李大婶.pmg", "portrait": "李大婶.bmp", "script": "", "hp": 999, "attack": 0, "hostile": 0, "defence": 0, "level": 0, "exp": 0, "ai": 4, "skills": "原来是之望啊！\\n你娘跟我", "talks": ["原来是之望啊！\\n你娘跟我说了帮你挑个好媳妇，你就放心吧！", "如今世道不太平，我们还是少出村为好啊。", "唉，我家小虎不争气，老是出去打架。真是担心死我这个娘了。", "看到我家小娟了吗？"]}, {"id": 4, "name": "二叔", "model": "二叔.pmg", "portrait": "uncle.bmp", "script": "二叔.gsp", "hp": 900, "attack": 0, "hostile": 0, "defence": 0, "level": 0, "exp": 0, "ai": 3, "skills": "*/*", "talks": []}, {"id": 5, "name": "二婶", "model": "二婶.pmg", "portrait": "二婶.bmp", "script": "二婶.gsp", "hp": 999, "attack": 0, "hostile": 0, "defence": 0, "level": 0, "exp": 0, "ai": 4, "skills": "*/*", "talks": []}, {"id": 6, "name": "王老伯", "model": "王老伯.pmg", "portrait": "王老伯.bmp", "script": "", "hp": 999, "attack": 0, "hostile": 0, "defence": 0, "level": 0, "exp": 0, "ai": 4, "skills": "之望啊，江湖凶险，你出去", "talks": ["之望啊，江湖凶险，你出去闯荡之前最好到村外去杀几只野猴提升一下自已的实力。", "到了庄外的平原，往西是龙家庄，往北是扬州城。", "最近时局动荡，扬州城郊强盗横行，要小心。", "庄外平原东侧为花斑豹子所居，如武艺不精切莫前往！"]}, {"id": 7, "name": "小娟", "model": "小孩.pmg", "portrait": "", "script": "", "hp": 999, "attack": 0, "hostile": 0, "defence": 0, "level": 0, "exp": 0, "ai": 4, "skills": "之望哥，陪我一起玩吧！", "talks": ["之望哥，陪我一起玩吧！"]}, {"id": 8, "name": "野猴", "model": "猴子.pmg", "portrait": "", "script": "", "hp": 30, "attack": 2, "hostile": 0, "defence": 0, "level": 9, "exp": 9, "ai": 4, "skills": "*/*", "talks": []}, {"id": 9, "name": "花豹", "model": "花豹.pmg", "portrait": "", "script": "", "hp": 150, "attack": 40, "hostile": 0, "defence": 0, "level": 12, "exp": 11, "ai": 4, "skills": "*/*", "talks": []}, {"id": 10, "name": "强盗", "model": "强盗.pmg", "portrait": "强盗.bmp", "script": "", "hp": 250, "attack": 50, "hostile": 1, "defence": 22, "level": 13, "exp": 5, "ai": 4, "skills": "此路是我开，此树是我栽，", "talks": ["此路是我开，此树是我栽，要想把路过，留下买路财！"]}, {"id": 11, "name": "龙绝尘", "model": "师父.pmg", "portrait": "master.bmp", "script": "龙绝尘.gsp", "hp": 999, "attack": 0, "hostile": 0, "defence": 4294967295, "level": 4294967295, "exp": 4294967295, "ai": 3, "skills": "*/*", "talks": []}, {"id": 12, "name": "龙紫烟", "model": "师妹.pmg", "portrait": "ziyan.bmp", "script": "龙紫烟.gsp", "hp": 999, "attack": 0, "hostile": 0, "defence": 4294967295, "level": 4294967295, "exp": 4294967295, "ai": 3, "skills": "二师兄，带我去后山玩啊。", "talks": ["二师兄，带我去后山玩啊。", "我最喜欢吃冰糖葫芦了，以前每次都是大师兄买给我吃。", "爹老是怪我偷懒，其实我哪有啊。", "听人说后山的猴子会自己酿酒的。", "听说满洲人都力大如牛，不知道是不是真的。", "你要向我爹学习剑法，可要听我爹的话哦。"]}, {"id": 13, "name": "沈慈", "model": "沈慈_站.pmg", "portrait": "shenci.bmp", "script": "", "hp": 999, "attack": 0, "hostile": 0, "defence": 4294967295, "level": 4294967295, "exp": 4294967295, "ai": 4, "skills": "在下姓沈名慈，从三年前开", "talks": ["在下姓沈名慈，从三年前开始跟师父学武。", "后山闹山贼，你没事还是别去那里。", "小师妹喜欢吃冰糖葫芦，你能买到给她肯定能哄她开心。", "你觉得我俩的武功谁更强些？"]}, {"id": 14, "name": "沈 慈", "model": "沈慈.pmg", "portrait": "shenci.bmp", "script": "", "hp": 3000, "attack": 60, "hostile": 1, "defence": 2, "level": 24, "exp": 27, "ai": 4, "skills": "*/*", "talks": []}, {"id": 15, "name": "山贼", "model": "强盗.pmg", "portrait": "强盗.bmp", "script": "", "hp": 300, "attack": 40, "hostile": 1, "defence": 26, "level": 25, "exp": 0, "ai": 4, "skills": "留下银两，大王饶你不死！", "talks": ["留下银两，大王饶你不死！"]}, {"id": 16, "name": "山贼头目", "model": "贼首.pmg", "portrait": "山贼头目.bmp", "script": "", "hp": 1500, "attack": 80, "hostile": 1, "defence": 17, "level": 26, "exp": 22, "ai": 4, "skills": "老子看你活得不耐烦了！", "talks": ["老子看你活得不耐烦了！"]}, {"id": 17, "name": "陈近南", "model": "陈近南.pmg", "portrait": "cjn.bmp", "script": "陈近南.gsp", "hp": 999, "attack": 0, "hostile": 0, "defence": 4294967295, "level": 4294967295, "exp": 429496